# =========================================================================
# DOKIND CROWDFUNDING PLATFORM — ENVIRONMENT VARIABLES CONFIGURATION
# =========================================================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PLATFORM_NAME=dokind
NEXT_PUBLIC_APP_ENV=development

# Supabase PostgreSQL Database & Auth (Leave placeholder if using local in-memory store)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Razorpay Indian Payment Gateway
# Test keys begin with rzp_test_, Production keys begin with rzp_live_
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_placeholder
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_placeholder

# Section 80G & Form 10BE NGO Statutory Registration
DEFAULT_80G_REG_URN=AAATA4492MF20215
NITI_AAYOG_DARPAN_ID=DL/2016/0104822

# Authentication & Security Secret (Keyed HMAC-SHA256 for session, OTP and CSRF tokens)
AUTH_SECRET=your_high_entropy_random_auth_secret_minimum_32_characters

# Super Admin Initial Bootstrap Secret (Server-only secret, never expose to browser)
# Used strictly on initial deployment to initialize designated Super Admin accounts that lack a stored password hash.
# Once the Super Admin successfully logs in and sets a permanent password, remove or unset this variable in production.
ADMIN_BOOTSTRAP_PASSWORD=your_temporary_bootstrap_secret_remove_after_first_login

# Designated Super Admin Email Allowlist (Comma-separated)
# Only emails listed here can be provisioned or authenticated as founding Super Administrators.
INITIAL_SUPER_ADMIN_EMAILS=karnsaurabh1995@gmail.com,sarthakraj726@gmail.com

# Google OAuth 2.0 Client (Web Application credentials from Google Cloud Console)
# Authorized JavaScript origin: http://localhost:3000 (development) or https://dokind.org.in (production)
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback or https://dokind.org.in/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_oauth_client_id_placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_placeholder

# Transactional Email (Gmail SMTP / Google Workspace / Resend / AWS SES)
# For Gmail, generate a 16-character App Password from Google Account Security settings
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=your_sender_email@gmail.com
EMAIL_SERVER_PASSWORD=your_google_app_password
EMAIL_FROM="dokind Foundation" <auth@dokind.org.in>

# Google Analytics 4 & Tag Manager (Consent-Aware)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_placeholder

# MSG91 Mobile OTP Authentication Gateway (v5 API)
# Feature toggle: set to true once MSG91 credentials and DLT templates are configured
PHONE_OTP_ENABLED=false
# MSG91 Account Auth Key (keep secret, never expose to browser)
MSG91_AUTH_KEY=your_msg91_auth_key_placeholder
# MSG91 OTP Template ID configured in MSG91 dashboard (must include ##OTP## variable)
MSG91_OTP_TEMPLATE_ID=your_msg91_otp_template_id_placeholder
# Length of generated OTP (default 6 digits)
MSG91_OTP_LENGTH=6
# OTP Expiry duration in minutes (default 10)
MSG91_OTP_EXPIRY_MINUTES=10
# Default country dial code (91 for India)
MSG91_DEFAULT_COUNTRY_CODE=91
# Dev mode toggle: set to false in production to enforce real SMS delivery
MSG91_DEV_MODE=auto
